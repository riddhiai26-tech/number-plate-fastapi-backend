# Frontend origins, comma-separated.
# Replace these with the real Lovable deployment URL(s).
ALLOWED_ORIGINS=https://your-lovable-site.lovable.app,http://localhost:5173

# Keep CPU for broad compatibility. For a GPU host, a CUDA-capable
# PyTorch build and DEVICE=cuda:0 are required.
DEVICE=cpu

MODEL_PATH=/app/models/best_license_plate_model.pt
IMAGE_SIZE=320
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.7
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=25000000

TESSERACT_LANG=eng
TESSERACT_CONFIG=--psm 6
# Usually unnecessary inside the Docker image:
# TESSERACT_CMD=/usr/bin/tesseract
